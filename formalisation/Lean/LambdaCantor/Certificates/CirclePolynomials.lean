positivity uses only the two rational container bounds. -/

namespace LambdaCantor.Circle

theorem root_derivative_certificate (ratio : ℝ)
    (lower : (2679 / 10000 : ℝ) ≤ ratio)
    (upper : ratio ≤ (67 / 250 : ℝ)) :
    (3 / 1 : ℝ) < 4 - 2 * ratio - (381 / 100 : ℝ) * 8 * ratio ^ 7 := by
  have parameter_nonneg : 0 ≤ (ratio - 2679 / 10000) / (1 / 10000) := by linarith
  have complement_nonneg : 0 ≤ 1 - (ratio - 2679 / 10000) / (1 / 10000) := by linarith
  have expansion : (4 - 2 * ratio - (381 / 100 : ℝ) * 8 * ratio ^ 7) - (3 / 1 : ℝ) =
      (351694775128371937 / 1525878906250000000 : ℝ) +
      (28836823043304625281625315221 / 125000000000000000000000000000 : ℝ) * ((ratio - 2679 / 10000) / (1 / 10000)) ^ 0 * (1 - (ratio - 2679 / 10000) / (1 / 10000)) ^ 7 +
      (5045794383578241730933596431 / 3125000000000000000000000000 : ℝ) * ((ratio - 2679 / 10000) / (1 / 10000)) ^ 1 * (1 - (ratio - 2679 / 10000) / (1 / 10000)) ^ 6 +
      (378385854403301460778019889 / 78125000000000000000000000 : ℝ) * ((ratio - 2679 / 10000) / (1 / 10000)) ^ 2 * (1 - (ratio - 2679 / 10000) / (1 / 10000)) ^ 5 +
      (3152809411232630149283799 / 390625000000000000000000 : ℝ) * ((ratio - 2679 / 10000) / (1 / 10000)) ^ 3 * (1 - (ratio - 2679 / 10000) / (1 / 10000)) ^ 4 +
      (78810084083740192353827 / 9765625000000000000000 : ℝ) * ((ratio - 2679 / 10000) / (1 / 10000)) ^ 4 * (1 - (ratio - 2679 / 10000) / (1 / 10000)) ^ 3 +
      (5909994955705556294013 / 1220703125000000000000 : ℝ) * ((ratio - 2679 / 10000) / (1 / 10000)) ^ 5 * (1 - (ratio - 2679 / 10000) / (1 / 10000)) ^ 2 +
      (49243613286102315903 / 30517578125000000000 : ℝ) * ((ratio - 2679 / 10000) / (1 / 10000)) ^ 6 * (1 - (ratio - 2679 / 10000) / (1 / 10000)) ^ 1 +
      (351694775128371937 / 1525878906250000000 : ℝ) * ((ratio - 2679 / 10000) / (1 / 10000)) ^ 7 * (1 - (ratio - 2679 / 10000) / (1 / 10000)) ^ 0 := by ring
  have positive : 0 < (4 - 2 * ratio - (381 / 100 : ℝ) * 8 * ratio ^ 7) - (3 / 1 : ℝ) := by
    rw [expansion]
    positivity
  linarith

