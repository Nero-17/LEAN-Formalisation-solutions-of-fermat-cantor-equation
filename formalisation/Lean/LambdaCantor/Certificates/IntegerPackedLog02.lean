      packedLogTableCheck 50001 packedLogTable02 = true := by native_decide

theorem packedLogTable02_sources (n : ℕ) (lower : 50001 ≤ n) (upper : n ≤ 140000) :
    ∃ source : LogSourceData, source.GeometryChecked n ∧
      ∃ exponent, source.LogChecked n exponent := by
  apply packedLogTableCheck_sound 50001 packedLogTable02
    packedLogTable02_checked.2 n lower
  rw [packedLogTable02_checked.1]
  omega

end LambdaCantor.Integer
