theorem tail_endpoint_digits_check : tailParameterRows.all (fun row =>
  ternaryPrefix row.1 11 && decide (20*3^11 ≤ 243*row.1) &&
  decide (0 < row.2.1) && decide (row.2.1 ≤ row.2.2)) = true := by decide +kernel
theorem tail_parameter_cover_check : intervalCoverScan tailParameterIntervals 708588000 2125764000 = true := by decide +kernel
theorem tail_left_covered : ∃ interval ∈ tailParameterIntervals, interval.1 ≤ 708588000 ∧ 708588000 ≤ interval.2 := by
