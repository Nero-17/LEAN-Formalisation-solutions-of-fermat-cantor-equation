theorem tail_parameter_cover (t : ℝ) (lower : 1 ≤ t) (upper : t ≤ 3) :
    ∃ interval ∈ tailParameterIntervals,
      (interval.1 : ℝ)/708588000 ≤ t ∧ t ≤ (interval.2 : ℝ)/708588000 := by
  obtain ⟨interval, hmem, hlo, hhi⟩ := closed_integer_cover_sound tailParameterIntervals
    708588000 2125764000 tail_parameter_cover_check tail_left_covered
    (708588000*t) (by norm_num; nlinarith) (by norm_num; nlinarith)
  refine ⟨interval, hmem, ?_, ?_⟩ <;> norm_num at * <;> nlinarith
