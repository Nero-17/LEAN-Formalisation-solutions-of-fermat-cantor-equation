theorem sharedLogRows32_computed : sharedLogRows32.all (fun row =>
  decide (row.Checked sharedLogRowAtoms32) && decide row.GeometryChecked && decide row.IndexMatches) = true := by
  native_decide

theorem sharedLogRows32_checked : ∀ row ∈ sharedLogRows32,
    row.Checked sharedLogRowAtoms32 ∧ row.GeometryChecked ∧ row.IndexMatches := by
  simpa only [Array.all_eq_true', Bool.and_eq_true, decide_eq_true_eq, and_assoc] using sharedLogRows32_computed

def sharedSourceBlock32 : SharedSourceBlock := ⟨sharedLogRowAtoms32,sharedLogRows32⟩

theorem sharedSourceBlock32_accepted : sharedSourceBlock32.accepted = true :=
  SharedSourceBlock.accepted_of_checks sharedSourceBlock32 sharedLogRowAtoms32_computed sharedLogRows32_computed

