import LambdaCantor.RationalPowers.IdentifierLookup

namespace LambdaCantor.RationalPowers.CompactLow

def forgetPayload {Payload : Type} (entry : IdentifierEntry Payload) : IdentifierEntry Unit :=
  ⟨entry.identifier, ()⟩

def hexNibble (character : UInt8) : Nat :=
  let value := character.toNat
  if value ≤ 57 then value - 48 else value - 87

def decodeKeys (text : String) : Array (IdentifierEntry Unit) := Id.run do
  let bytes := text.toUTF8
  let mut result : Array (IdentifierEntry Unit) := #[]
  for index in [0 : bytes.size / 8] do
    let mut value : Nat := 0
    for offset in [0 : 8] do
      value := 16 * value + hexNibble bytes[8*index+offset]!
    result := result.push ⟨value, ()⟩
  return result

def encodedKeys : String := ""

def entries : Array (IdentifierEntry Unit) := decodeKeys encodedKeys

end LambdaCantor.RationalPowers.CompactLow
