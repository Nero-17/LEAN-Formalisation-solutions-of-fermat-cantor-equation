import Mathlib.Algebra.Field.Subfield.Basic
import Mathlib.Tactic.DeriveCountable
import Mathlib.Data.Set.Countable
import Mathlib.Analysis.SpecialFunctions.Pow.Real
import Mathlib.Tactic.Linarith

noncomputable section
namespace LambdaCantor.Last

/-- Finite field expressions in one real parameter. Their values are exactly
the field generated by that parameter over the prime field. -/
inductive ParameterFieldExpression where
  | zero | one | parameter
  | add : ParameterFieldExpression → ParameterFieldExpression → ParameterFieldExpression
  | mul : ParameterFieldExpression → ParameterFieldExpression → ParameterFieldExpression
  | neg : ParameterFieldExpression → ParameterFieldExpression
  | inv : ParameterFieldExpression → ParameterFieldExpression
  deriving Countable

def ParameterFieldExpression.evaluate (ratio : ℝ) : ParameterFieldExpression → ℝ
  | .zero => 0
  | .one => 1
  | .parameter => ratio
  | .add first second => first.evaluate ratio + second.evaluate ratio
  | .mul first second => first.evaluate ratio * second.evaluate ratio
  | .neg expression => -(expression.evaluate ratio)
  | .inv expression => (expression.evaluate ratio)⁻¹

/-- The countable subfield `ℚ(ratio)` of the real numbers. -/
def parameterField (ratio : ℝ) : Subfield ℝ where
  carrier := Set.range (ParameterFieldExpression.evaluate ratio)
  zero_mem' := ⟨.zero, rfl⟩
  one_mem' := ⟨.one, rfl⟩
  add_mem' := by
    rintro _ _ ⟨first, rfl⟩ ⟨second, rfl⟩
    exact ⟨.add first second, rfl⟩
  mul_mem' := by
    rintro _ _ ⟨first, rfl⟩ ⟨second, rfl⟩
    exact ⟨.mul first second, rfl⟩
  neg_mem' := by
    rintro _ ⟨expression, rfl⟩
    exact ⟨.neg expression, rfl⟩
  inv_mem' := by
    rintro _ ⟨expression, rfl⟩
    exact ⟨.inv expression, rfl⟩

theorem countable_parameterField (ratio : ℝ) : (parameterField ratio : Set ℝ).Countable :=
  Set.countable_range _

theorem ratio_mem_parameterField (ratio : ℝ) : ratio ∈ parameterField ratio :=
  ⟨.parameter, rfl⟩

theorem parameterField_le {ratio : ℝ} {field : Subfield ℝ} (membership : ratio ∈ field) :
    parameterField ratio ≤ field := by
  rintro _ ⟨expression, rfl⟩
  induction expression with
  | zero => exact field.zero_mem
  | one => exact field.one_mem
  | parameter => exact membership
  | add first second first_mem second_mem => exact field.add_mem first_mem second_mem
  | mul first second first_mem second_mem => exact field.mul_mem first_mem second_mem
  | neg expression membership => exact field.neg_mem membership
  | inv expression membership => exact field.inv_mem membership

theorem parameterField_eq_closure (ratio : ℝ) :
    parameterField ratio = Subfield.closure ({ratio} : Set ℝ) := by
  apply le_antisymm
  · exact parameterField_le (Subfield.subset_closure (Set.mem_singleton ratio))
  · apply Subfield.closure_le.mpr
    intro coordinate membership
    have coordinate_eq : coordinate = ratio := Set.mem_singleton_iff.mp membership
    rw [coordinate_eq]
    exact ratio_mem_parameterField ratio

/-- Cylinder rescaling and coordinate exchange preserve exclusion from ℚ(λ). -/
theorem mul_not_mem_parameterField {ratio scale value : ℝ}
    (scale_mem : scale ∈ parameterField ratio) (scale_nonzero : scale ≠ 0)
    (value_outside : value ∉ parameterField ratio) :
    scale * value ∉ parameterField ratio := by
  intro product_mem
  apply value_outside
  have quotient_mem := (parameterField ratio).div_mem product_mem scale_mem
  simpa [mul_div_cancel_left₀ value scale_nonzero] using quotient_mem

theorem inv_not_mem_parameterField {ratio value : ℝ}
    (value_outside : value ∉ parameterField ratio) :
    value⁻¹ ∉ parameterField ratio := by
  intro inverse_mem
  exact value_outside (by simpa using (parameterField ratio).inv_mem inverse_mem)

end LambdaCantor.Last
